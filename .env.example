# ─── Geokodowanie ───────────────────────────────────────────────
# Dostępne wartości: "nominatim" (domyślnie) lub "photon"
VITE_GEOCODING_PROVIDER=nominatim

# ─── Routing ────────────────────────────────────────────────────
VITE_ROUTING_PROVIDER=osrm
VITE_OSRM_BASE_URL=https://router.project-osrm.org

# ─── Supabase (opcjonalne, synchronizacja w chmurze) ────────────
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Ruch drogowy (opcjonalne) ──────────────────────────────────
# Klucz TomTom Traffic API. Bez klucza aplikacja nie pokazuje korków
# (nie fałszujemy danych). Darmowy plan: 2500 zapytań/dzień.
# Rejestracja: https://developer.tomtom.com/
# VITE_TOMTOM_API_KEY=twój_klucz_tomtom